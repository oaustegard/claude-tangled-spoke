# Copy to .env and fill in. .env is gitignored.

# Your ATProto handle. Either a Bluesky handle (alice.bsky.social) or a
# Tangled-managed one (alice.tngl.sh) works — tg resolves PDS via the DID doc.
ATPROTO_HANDLE=alice.bsky.social

# An *app password*, NOT your main account password.
# Create one at: https://bsky.app/settings/app-passwords
# Or for a tngl.sh account: https://tangled.org/settings/app-passwords
ATPROTO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: SSH private key for git push to Tangled.
# Add the matching public key via `tg ssh-key add` once logged in, or paste it
# into https://tangled.org/settings/keys
# If unset, boot.sh also looks for $PROJECT_DIR/.ssh/id_ed25519.
# TANGLED_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
